@model JobsViewModel

<h1>Jobs</h1>
<partial name="_StatusMessage" model="@TempData["StatusMessage"]" />
@if (Model.Jobs.Any())
{
    <table class="table-striped">
        <thead class="bg-success">
            <tr class="row">
                <td class="col-10">
                    Job
                </td>
                <td class="col-2">
                    Apply
                </td>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.Jobs)
            {
                <tr class="row">
                    <td class="col-10">
                        @job.JobTitle
                    </td>
                    @if (Model.JobApplications.Exists(a => a.JobId == job.Id))
                    {
                        <td class="col-2 text-success">
                            Applied
                        </td>
                    }
                    else
                    {
                        <td class="col-2">
                            <a class="btn btn-primary" asp-action="ApplyForJob" asp-route-id="@job.Id">
                                Apply
                            </a>
                        </td>
                    }

                </tr>
            }
        </tbody>

    </table>
}
else
{
    <h3>No Jobs to Apply</h3>
}