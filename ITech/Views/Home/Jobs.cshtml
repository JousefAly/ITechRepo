@model JobsViewModel

<h1>Jobs</h1>
<partial name="_StatusMessage" model="@TempData["StatusMessage"]" />
@if (Model.Jobs.Any())
{
    <table class=" table table-striped">
        <thead>
            <tr >
                <th >
                    Job
                </th>
                <th>
                    Apply
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.Jobs)
            {
                <tr >
                    <td>
                        @job.JobTitle
                    </td>
                    @if (Model.JobApplications.Exists(a => a.JobId == job.Id))
                    {
                        <td class="text-success">
                            Applied
                        </td>
                    }
                    else
                    {
                        <td >
                            <a class="btn btn-primary" asp-action="ApplyForJob" asp-route-id="@job.Id">
                                Apply
                            </a>
                        </td>
                    }

                </tr>
            }
        </tbody>

    </table>
}
else
{
    <h3>No Jobs to Apply</h3>
}