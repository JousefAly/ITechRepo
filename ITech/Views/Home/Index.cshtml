@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}

<section class="header_two">
    <div class="content">
        <div class="text-center text-capitalize">
            <h4>What is in your mind?</h4>
        </div>
        <form action="/" method="post" class="search">
            <input type="text" name="name" value="" placeholder="Search ..." class="search_input form-control" style=" border-bottom-left-radius: 25px;" />
            <button class="search_button"><i class="fa fa-search"></i></button>
        </form>
    </div>

</section>

<div style="position:relative">

    <h1 class="title-text text-center">Recently Arrival</h1>

</div>





<section class="slider">

    <ul class="autoWidth cs-hidden">

        @foreach (var Product in Model)
        {


            <li class="item-a">

                <div class="box">
                    <div class="slide-image">

                        <img src="~/img/mockImages/@Product.Image1Name" />
                        <div class="overlay">
                            <a href="#" class="buy-btn">Buy Now</a>
                        </div>
                    </div>



                    <div class="detail-box">
                        <div class="type">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@Product.Id">@Product.Title</a>

                        </div>

                        <a href="#" class="price">@Product.Price EGP</a>


                    </div>

                </div>

            </li>
        }
      
    </ul>
            
</section>

