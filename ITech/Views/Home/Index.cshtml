@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}
<style>
    body{
        background-color:#ffffff;
    }
    .cart {
        background-color: #F5F5F5;
        width: 940px;
        margin: 50px auto 0;
        padding: 15px;
        border-radius: 5px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        box-shadow: 0px 0px 5px 5px gray;
    }
    .thems img {
            display:inline-block;
            height:80px;
            width:80px;
            border:1px solid #ccc;
            margin:7px;
            border-radius:8px;
    }
    .xzoom-container .xzoom {
        width: 300px;
        height:300px;
    }
        .thems img:hover {
            
            transform: scale3d(3,4,0) rotateY(0deg);
            transition: all 2s;
        }
    .thems a{
        text-decoration:none;
    }
</style>

<div class="cart" >
        <div class="xzoom-container">
            <img src="~/img/csvImages/IT-CSV-1-img-1.jpg" class="xzoom" xriginal="~/img/csvImages/IT-CSV-1-img-1.jpg"/>
            
        </div>
        <div class="description" style="">
            <h1 style="font-weight:300">tittle</h1>
            <p>Brand:....<br>more detailes: </p>
            <hr>
            <span class="font-weight-bold" style="font-weight:550px; font-size:30px;"> EGP 3300</span>
            <span><s> EGP 3300</span> <br>
            <button class="btn btn-primary" style="font-size: 25px; padding: px 50px; width: 500px; margin-top:15px;">ADD TO CART</button>
        </div>
    </div>


<script>
    $(function () {
        $(".xzoom,.gallery").xzoom({
            zoomWidth: 400,
            tint:"#333",
            Xoffset: 15,
        });
    });

</script>