@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}
<!--Display products here-->
<!--This table is just a test replace it with viewPartial soon!-->
<table class="table">
    <thead class="thead-dark">
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Price</th>
            <th scope="col">Category</th>
            <th scope="col">Main image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <th scope="row">@product.Id</th>
                <td><a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Title</a></td>
                <td>@product.Price.ToString("c")</td>
                <td>@product.Category.Name</td>

                <td>@*<img src="/img/mockImages/@product.Image1Name" width="250" height="250" />*@</td>

            </tr>

        }
    </tbody>
</table>