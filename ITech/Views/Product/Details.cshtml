@model Product
<!--Product Details page code here hello ismail-->

<link rel="stylesheet" href="~/css/product/ProductDetails.css"/>

<div class="cart">
    <div class="mainImg-container">
        <img src="~/img/mockImages/@Model.Image1Name" class="mainImg" xriginal="~/img/mockImages/@Model.Image1Name" />
        <div class="thems">

            <a href="~/img/mockImages/@Model.Image2Name">
                <img class="gallary" id="one" src="~/img/mockImages/@Model.Image2Name" xpreview="~/img/csvImages/@Model.Image2Name " />
            </a>
            <a href="~/img/mockImages/@Model.Image3Name">
                <img class="gallary" id="two" src="~/img/mockImages/@Model.Image3Name" />
            </a>
            <a href="~/img/mockImages/@Model.Image4Name">
                <img class="gallary" id="three" src="~/img/mockImages/@Model.Image4Name" />
            </a>

        </div>
    </div>
    <div class="description" style="">
        <h1 style="font-weight:200"> @Model.Title </h1>
        <p>Brand: @Model.Brand</p>
        <hr>
        <span class="price"> @Model.Price </span><br /> <spam>@Model.DiscountPercentage</spam>
        <span class="font-weight-bold" style="font-weight:550px; font-size:30px;"></span>
        <span></span> <br>
        <button class="btn btn-primary" style="font-size: 25px; padding: px 50px; width: 550px; margin-top:15px;">ADD TO CART <i class="fas fa-cart-plus"></i></button>

    </div>
</div>


<div class="ProductDetails">
    <h1>Product Details</h1>
    <hr />
    <ul>
        <li>
            <h2>short description </h2>
            <p>@Model.ShortDescription</p>
        </li>
        <li>
            <h2>Lunch Time</h2>
            <p>@Model.LaunchTime</p>
        </li>
    </ul>

</div>



