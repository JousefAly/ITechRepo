}
@{ 
    var firstImage = Model.ProductImages.FirstOrDefault(i => i.ImageNumber == 1);
}

<div class="cart">
    <div class="mainImg-container">
        <img src="~/@firstImage.ImageUrl" class="mainImg" xriginal="~/@firstImage.ImageUrl" />
        @foreach (var image in Model.ProductImages)
        {
           //display rest of the images here 
        }

        @*<div class="thems">

            <a href="~/img/mockImages/@Model.Image2Name">
                <img class="gallary" id="one" src="~/img/mockImages/@Model.Image2Name" xpreview="~/img/csvImages/@Model.Image2Name " />
            </a>
            <a href="~/img/mockImages/@Model.Image3Name">
                <img class="gallary" id="two" src="~/img/mockImages/@Model.Image3Name" />
            </a>
            <a href="~/img/mockImages/@Model.Image4Name">
                <img class="gallary" id="three" src="~/img/mockImages/@Model.Image4Name" />
            </a>

        </div>*@
    </div>
    <div class="description" style="">
        <h1 style="font-weight:200"> @Model.Title </h1>
        <p>Brand: @Model.Brand</p>
        <hr>
        <span class="price"> @Model.Price.ToString("c") </span> @if (Model.DiscountPercentage > 0)
        {<span style="text-decoration:line-through;"> @Model.PriceAfterDiscount</span><br /> <spam>@Model.DiscountPercentage</spam>}
        <span class="font-weight-bold" style="font-weight:bold; font-size:30px;"></span>
        <span></span> <br>
        <button class="btn btn-primary" style="font-size: 25px; width:100%; ">ADD TO CART <i class="fas fa-cart-plus"></i></button>

    </div>
</div>


<div class="ProductDetails">
    <h1><i class="fas fa-info-circle"></i>Product Details </h1>
    <hr />
    <ul class="list-unstyled">
        <li>
            <h2>short description </h2>
            <p>@Model.ShortDescription</p>
        </li>
        <li>
            <h2>Lunch Time</h2>
            <p>@Model.LaunchTime</p>
        </li>
    </ul>

</div>

<div class="moreDetails">
    <table>
        <thead>
            <tr>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.ProductDetails)
            {
                <tr>
                    <td>@detail.Title</td>
                    <td>@detail.Content</td>
                </tr>
            }
        </tbody>
    </table>
</div>

