@model Product
<!--Product card Start-->

    <div class="card product-item border-0 mb-4">
        <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
            @if (Model.ProductImages.Any()
              && Model.ProductImages.FirstOrDefault(p => p.ImageNumber == 1) != null)
            {
                <img class="img-fluid w-100" src="~/@Model.ProductImages.FirstOrDefault(p => p.ImageNumber == 1).ImageUrl" alt="">
            }
        </div>
        <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
            <h6 class="text-truncate mb-3">@Model.Title</h6>
            <div class="d-flex justify-content-center">
                <h6>@Model.PriceAfterDiscount</h6><h6 class="text-muted ml-2"><del>@Model.Price</del></h6>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between bg-light border">
            <a class="btn btn-sm text-dark p-0" asp-controller="EditProduct" asp-action="Index" asp-route-productId="@Model.Id"><i class="fas fa-edit text-primary mr-1"></i>Edit</a>
            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-sm text-dark p-0" asp-controller="Products" asp-action="ProductStats" asp-route-id="@Model.Id"><i class="fas fa-chart-bar text-success mr-1"></i>Stats</a>
                <a class="btn btn-sm text-dark p-0" asp-controller="Products" asp-action="Delete" asp-route-id="@Model.Id"><i class="fas fa-trash text-danger mr-1"></i>Delete</a>
            }
        </div>
    </div>

<!--Product card End-->