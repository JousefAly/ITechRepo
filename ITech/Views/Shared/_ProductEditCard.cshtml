@model Product
<!--Product card Start-->
<div class="col-lg-3 col-md-6 col-sm-12 pb-1">
    <div class="card product-item border-0 mb-4">
        <div class="card-header product-img position-relative overflow-hidden bg-transparent border p-0">
            @if (Model.ProductImages.Any()
               && Model.ProductImages.FirstOrDefault(p => p.ImageNumber == 1) != null)
            {
                <img class="img-fluid w-100" src="~/@Model.ProductImages.FirstOrDefault(p => p.ImageNumber == 1).ImageUrl" alt="">
            }
        </div>
        <div class="card-body border-left border-right text-center p-0 pt-4 pb-3">
            <h6 class="text-truncate mb-3">@Model.Title</h6>
            <div class="d-flex justify-content-center">
                <h6>@Model.PriceAfterDiscount</h6><h6 class="text-muted ml-2"><del>@Model.Price</del></h6>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between bg-light border">
            <a asp-controller="Products" asp-action="Edit" class="btn btn-sm text-dark p-0"><i class="fas fa-edit text-primary mr-1"></i>Edit</a>
            <a asp-controller="Products" asp-action="Delete" class="btn btn-sm text-dark p-0"><i class="fas fa-trash text-primary mr-1"></i>Delete</a>
        </div>
    </div>
</div>
<!--Product card End-->