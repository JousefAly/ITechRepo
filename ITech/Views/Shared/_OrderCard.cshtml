@model Order

<div class="card m-1">
    <div class="card-header">
        <h4>Customer: @Model.User.UserName</h4>
        <h6>Email: @Model.User.Email</h6>
    </div>
    <div class="card-body">
        <h6>Details</h6>
        @foreach (var od in Model.OrderDetails)
        {
            <p>(@od.Amount)  @od.Product.Title</p>
        }
    </div>
    <div class="card-footer">
        <div class="row">
            <div class="col-9">
                <p> @Model.OrderPlaced.ToString("f")</p>
            </div>
            <div class="col-3">
                <p>Total: @Model.OrderTotal.ToString("c")</p>
            </div>
        </div>
    </div>
</div>