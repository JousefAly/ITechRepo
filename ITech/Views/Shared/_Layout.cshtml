<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        .flex-wrapper {
            display: flex;
            min-height: 100vh;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITech</title>
    <!--<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/lib/font-awesome/css/all.css" rel="stylesheet" />
    <link href="~/lightslider/src/css/lightslider.css" rel="stylesheet" />
    <!--render other styles per view-->
    @RenderSection("Styles", required: false)
</head>


<body>

    <div class="flex-wrapper">
        <div class="container2">
            <header>

                <nav class="navbar navbar-expand-lg navbar-light bg-light">
                    <div class="container-fluid">
                        <a class="navbar-brand" href="#">ITech</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse justify-content-center" id="navbarSupportedContent">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0 navbar-ul">

                                <li class="nav-item">
                                    <a class="nav-link active" aria-current="page" href="#">Mobiles</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#">Tablets</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="#">Laptops</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link " href="#">Accessories</a>
                                </li>
                            </ul>

                        </div>
                        <form class="d-flex">
                            <button class="btn" id="login" type="button"><i class="fas fa-sign-in-alt"></i> Login</button>
                            <button class="btn" id="basket" type="button"><i class="fas fa-shopping-cart"></i>  basket</button>
                        </form>
                    </div>
                </nav>


            </header>


            <div id="smallScreen" class="col-lg-12 col-sm-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>




        </div>
        <div class="footer">
          
            <footer class="footer bg-dark text-white">

                <div class="container">
                    <div class="row">
                        <div class="col-md text-center first-part">
                            <h2>ITech online shop</h2>
                            <p>ITech Is the Biggest Telecommunication Retail chain in Egypt since 2006.</p>
                            <p>
                                It is offering an extremely wide range of the best telecommunications & Accessories products,
                                having expert and dedicated staff that are always ready to be of service to you.
                            </p>
                        </div>
                        <div class="col-md second-part text-center">
                            <h2>Quick Links</h2>
                            <ul class="list-unstyled">
                              <li><a href="#">About us</a></li>
                              <li><a href="#">Terms&Conditions</a></li>
                              <li><a href="#">Privacy policy</a></li>
                              <li><a href="#">Contact us</a></li>
                            </ul>
                        </div>
                        <div class="col-md third-part">
                            <h2>Follow us on</h2>
                            <ul class="list-unstyled social-media">
                                <li><a href="#"><i class="fab fa-facebook fa-2x"></i></a></li>
                                <li><a href="#"><i class="fab fa-twitter fa-2x"></i></a></li>
                            </ul>
                            <h2>Contact information</h2>
                            <ul class="list-unstyled contact-list">
                                <li><i class="fa fa-map-marker"></i> <span>address of the shop</span></li>
                                <li><i class="fa fa-phone"></i> <span>Call Us: 1234</span></li>
                                <li><i class="fas fa-envelope"></i><span><a href="mailto:emailaddress@itech.com?subject=content">content</a></span></li>
                            </ul>
                        </div>
                       
                    </div>
                </div>

            </footer>
           
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/jquerylib.js"></script>
    <script src="~/lightslider/src/js/lightslider.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


