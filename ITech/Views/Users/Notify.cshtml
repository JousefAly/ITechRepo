@model Notification

<h1>Send Notification to @Model.Receiver.UserName</h1>

<form asp-controller="Users" asp-action="Notify" method="post">
    <div hidden>
        <input asp-for="Id" value=""/>
        <input asp-for="ReceiverId" />
        <input asp-for="SenderId" />
    </div>
    <div class="form-group">
        <label asp-for="Message" class="control-label"></label>
        <input asp-for="Message" class="form-control" required/>
        <span asp-validation-for="Message" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Send" class="btn btn-primary" />
    </div>
</form>