@model ManageUserViewModel

<partial name="_StatusMessage" model="@TempData["StatusMessage"]" />
<h1>Manage Seller, @Model.User.UserName</h1>

<!--Manage Seller-->
<div class="card ">
    <div class="card-header">
        <h6>Seller Activation Settings</h6>

    </div>
    <div class="card-body">
        @if (Model.Seller.Activated)
        {
            <p>State : <span class="text-success">Active</span>.</p>
            <p>Number of Products: @Model.Seller.Products.Count</p>
            <p class="text-success">Active Products: @Model.Seller.Products.Count(p => p.Activated)</p>
        }
        else
        {
            <p>State : <span class="text-danger">Not Active</span>.</p>
            <p>Number of Products: @Model.Seller.Products.Count <span class="text-danger"> Not Active</span></p>
        }
    </div>
    <div class="card-footer">
        <div class="row">
            <a class="btn btn-success m-1" asp-action="ActivateSeller" asp-route-id="@Model.User.Id">Activate Seller</a>
            <a class="btn btn-danger m-1" asp-action="DesActivateSeller" asp-route-id="@Model.User.Id">DesActivate Seller</a>
            <a class="btn btn-success m-1" asp-action="ActivateSellerProducts" asp-route-id="@Model.User.Id">Activate Seller Products</a>
            <a class="btn btn-danger m-1" asp-action="DesActivateSellerProducts" asp-route-id="@Model.User.Id">DesActivate Seller Products</a>
        </div>
    </div>
</div>

<!--Add Products and own orders here-->
@if (Model.SellerProductStats.Any())
{
    <div class="jumbotron m-1">
        <h2>Seller Products stats:</h2>
        <!-- loop for a partial that display product stats-->
        <div class="row">
            @foreach (var pStat in Model.SellerProductStats)
            {
            <div class="col-md-4">
                <partial name="_ProductStats" model="@pStat" />
                @if (pStat.Product.Activated)
                {
                    <a class="btn btn-danger mr-1"
                       asp-controller="Products" asp-action="DeactivateProduct" asp-route-id="@pStat.Product.Id">
                        Deactivate
                    </a>
                }
                else
                {
                    <a class="btn btn-success mr-1"
                       asp-controller="Products" asp-action="ActivateProduct" asp-route-id="@pStat.Product.Id">
                        Activate
                    </a>
                }
            </div>
            }
        </div>
    </div>
}
else
{
    <div class="jumbotron">
        <h2>Seller Does not have Products!</h2>
    </div>
}
@if (Model.Orders.Any())
{
    <div class="jumbotron">
        <h2>Ordrers Sellers Asked From ITech:</h2>
        <div class="row">
            @foreach (var o in Model.Orders)
            {
                <div class=" col-6 col-md-3">
                    <partial name="_OrderCard" model="o" />
                </div>
            }
        </div>

    </div>
}

