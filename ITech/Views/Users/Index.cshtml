@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Users";
}
<partial name="_StatusMessage" model="@TempData["StatusMessage"]" />
<h1>Users</h1>
<table class="table table-striped ">
    <thead>
        <tr class="bg-primary text-white">
            <th>First Name</th>
            <th>Last Name</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@string.Join(" , ", user.Roles.ToList())</td>
                <td>
                    <a class="btn btn-primary" asp-controller="Users" asp-action="ManageRoles" asp-route-userId="@user.Id"> Manage Roles</a>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Edit User"><i class="fas fa-edit "></i></a>
                    <a asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" title="Delete User"><i class="fas fa-trash text-danger"></i></a>
                </td>

            </tr>
        }
    </tbody>

</table>