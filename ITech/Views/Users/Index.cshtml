@model IEnumerable<UserViewModel>
@{
    ViewData["Title"] = "Users";
    Layout = "_AdminLayout";
}

<h1>Users</h1>
<table class="table table-striped">
    <thead>
        <tr class="bg-primary text-white">
            <th>First Name</th>
            <th>Last Name</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
        <tr>
            <td>@user.FirstName</td>
            <td>@user.LastName</td>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>@user.Roles.</td>
            <td>@string.Join(" , ", user.Roles)</td>
            <td></td>

        </tr>
        }
    </tbody>

</table>