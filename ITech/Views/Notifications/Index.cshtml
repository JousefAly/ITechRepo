@model IEnumerable<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h1>Notifications</h1>
@if (!Model.Any())
{
    <div class="jumbotron">
        <h6>You have no Notifications.</h6>
    </div>
}

@foreach (var n in Model)
{
    <div class="jumbotron">
        <h6>@n.Message</h6>
        <hr class="my-1">
        <p>Sent: @n.SentTime</p>
    </div>
}