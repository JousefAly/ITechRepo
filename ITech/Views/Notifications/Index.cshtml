@model IEnumerable<Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h1>Notifications</h1>
@if (!Model.Any())
{
    <div class="jumbotron">
        <h6>You have no Notifications.</h6>
    </div>
}

@foreach (var n in Model)
{
    <div class="jumbotron">
        <h6>@n.Message</h6>
        <hr class="my-1">
        <p>Sent: @n.SentTime</p>
        @if (!n.Checked)
        {
            <a class="btn btn-primary" asp-action="Check" asp-route-id="@n.Id">
                <i class="fas fa-check"></i>
            </a>
        }
    </div>
}