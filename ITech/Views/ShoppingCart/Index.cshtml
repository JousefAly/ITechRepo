@model ShoppingCartViewModel

<h2>Your shopping cart</h2>
@if (!Model.ShoppingCartItems.Any())
{
    <h4>
        You Dont have products in Your cart.
        <a asp-controller="Home" asp-action="Index">Start Shopping now!</a>
    </h4>
}
else
{


    <h4>Here are the products in your shopping cart.</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Selected amount</th>
                <th>Product</th>
                <th class="text-right">Price</th>
                <th class="text-right">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.ShoppingCartItems)
            {
                <tr>
                    <td class="text-center">@line.Amount</td>
                    <td class="text-left">@line.Product.Title</td>
                    <td class="text-right">@line.Product.PriceAfterDiscount.ToString("c")</td>
                    <td class="text-right">
                        @((line.Amount * line.Product.PriceAfterDiscount).ToString("c"))
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right">Total:</td>
                <td class="text-right">
                    @Model.ShoppingCartTotal.ToString("c")
                </td>
            </tr>
        </tfoot>
    </table>

    <div class="text-center">
        <a class="btn btn-primary" asp-controller="Order" asp-action="Checkout">Check out Now!</a>
    </div>
}
