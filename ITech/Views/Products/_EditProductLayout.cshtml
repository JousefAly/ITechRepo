@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout))
    {
        Layout = (string)parentLayout;
    }
    else
    {
        Layout = "/_Layout";
    }
    
}

<h2>Manage Product</h2>

<div>
    
    <hr />
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageProductNav"/>
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>
