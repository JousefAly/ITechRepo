@model AddProductDetailViewModel
@{
    var wasAddingDetail = false;
    var isDetailAdded = false;
    if (TempData["isDetailAdded"] != null)
    {
        wasAddingDetail = true;
        isDetailAdded = (bool)TempData["isDetailAdded"];

    }
}
@if (Model.ProductDetails.Any())
{


    @if (wasAddingDetail)
    {
        @if (isDetailAdded)
        {
            <div class="alert-success">
                <p>Detail was added successfully!</p>
            </div>
        }
        else
        {
            <div class="alert-danger">
                <p>Detail was not added!</p>
            </div>
        }
    }
    <h3>Add new product Detail to this list</h3>
    <table class="table-responsive table-striped mt-1">
        <thead class="thead-dark">
            <tr>
                <th class="col-3 mr-2" scope="col">Title</th>
                <th class="col-9"scope="col">Content</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model.ProductDetails)
            {

                <tr>
                    <th class="col-3 mr-2" scope="row">@detail.Title</th>
                    <td class="col-9">@detail.Content</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <h3> Add the first Product Detail</h3>
}

<form asp-action="AddProductDetail" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div hidden>
        <input asp-for="ProductId" value="@Model.ProductId" />
    </div>
    <div class="form-group">
        <label asp-for="Title" class="col-md-2 control-label"></label>
        <div class="col-md-5">
            <input asp-for="Title" class="form-control" placeholder="Detail Subject" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <label asp-for="Content" class="col-md-2 control-label"></label>
        <div class="col-md-5">
            <textarea class="form-control" asp-for="Content" rows="3" placeholder="Detail Content..."></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-5">
            <input type="submit" class="btn btn-primary" value="Add" />
            <a class="btn btn-danger" asp-action="Index">Cancel</a>
        </div>
    </div>
</form>