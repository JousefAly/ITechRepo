@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid pt-5">
    <div class="row px-xl-5 pb-3">
        @foreach (var product in Model)
        {
            <div class="col-lg-3 col-md-6 col-sm-12 pb-1">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>
</div>

