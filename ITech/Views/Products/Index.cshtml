@model List<Product>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid pt-5">
    <div class="row px-xl-5 pb-3">
        @foreach (var product in Model)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</div>
