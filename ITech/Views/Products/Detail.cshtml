@model ProductDetailViewModel
@{

}
@section Styles{
    <link href="~/css/product/ProductDetailStyle.css" rel="stylesheet" />
}
<div class="container">
    <div class="card-wrapper">
        <div class="card">
            <!-- card left -->
            <div class="product-imgs">
                <div class="img-display">
                    <div class="img-showcase">
                        @foreach (var img in Model.Product.ProductImages)
                        {
                            if (!string.IsNullOrEmpty(img.ImageUrl))
                            {
                                <img src="~/@img.ImageUrl" alt="@img.ImageNumber">
                            }
                        }
                    </div>
                </div>
                <div class="img-select">
                    <div class="row">
                        @foreach (var img in Model.Product.ProductImages)
                        {
                            <div class="img-item col-2">
                                <a href="#" data-id="@img.ImageNumber">
                                    <img src="~/@img.ImageUrl" alt="@img.ImageNumber">
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <!-- card right -->
            <div class="product-content">
                <h2 class="product-title">@Model.Product.Title</h2>
                <a href="#" class="product-link">@Model.Product.Brand</a>
                <!--Rating Start (add later)-->
                <div class="product-rating">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star-half-alt"></i>
                    <span>4.7(21)</span>
                </div>
                <!--Rating End (add later)-->

                @if (Model.Product.DiscountPercentage > 0)
                {
                    <div class="product-price">
                        <p class="last-price">Old Price: <span>EGP @Model.Product.Price </span></p>
                        <p class="new-price">
                            New Price:
                            <span>
                                EGP @Model.Product.PriceAfterDiscount (@Model.Product.DiscountPercentage%)
                            </span>
                        </p>
                    </div>
                }
                else
                {
                    <div class="product-price">                        
                        <p class="new-price">
                            Price:
                            <span>
                                EGP @Model.Product.Price
                            </span>
                        </p>
                    </div>
                }

                <div class="product-detail">
                    <h2>about this item: </h2>
                    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Illo eveniet veniam tempora fuga tenetur placeat sapiente architecto illum soluta consequuntur, aspernatur quidem at sequi ipsa!</p>
                    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Consequatur, perferendis eius. Dignissimos, labore suscipit. Unde.</p>
                    <ul>
                        <li>Color: <span>Black</span></li>
                        <li>Available: <span>in stock</span></li>
                        <li>Category: <span>Shoes</span></li>
                        <li>Shipping Area: <span>All over the world</span></li>
                        <li>Shipping Fee: <span>Free</span></li>
                    </ul>
                </div>

                <div class="purchase-info">
                    <input type="number" min="0" value="1">
                    <button type="button" class="btn">
                        Add to Cart <i class="fas fa-shopping-cart"></i>
                    </button>
                    <button type="button" class="btn">Compare</button>
                </div>

                <div class="social-links">
                    <p>Share At: </p>
                    <a href="#">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="#">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#">
                        <i class="fab fa-whatsapp"></i>
                    </a>
                    <a href="#">
                        <i class="fab fa-pinterest"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts{
    <script src="~/js/product/ProductDetailScript.js"></script>
}