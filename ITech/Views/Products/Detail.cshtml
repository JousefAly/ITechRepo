@model ProductDetailViewModel
@{
    var userAuthintecated = User.Identity.IsAuthenticated;
}
@section Styles{
    <link href="~/css/product/ProductDetailStyle.css" rel="stylesheet" />
}
<partial name="_StatusMessage" model="@TempData["StatusMessage"]" />
<div class="container">
    <div class="card-wrapper m-2   p2">
        <div class="card">
            <!-- card left -->
            <div class="product-imgs">
                <div class="img-display">
                    <div class="img-showcase">
                        @foreach (var img in Model.Product.ProductImages)
                        {
                            if (!string.IsNullOrEmpty(img.ImageUrl))
                            {
                                <img src="~/@img.ImageUrl" alt="@img.ImageNumber">
                            }
                        }
                    </div>
                </div>
                <div class="img-select">
                    <div class="row">
                        @foreach (var img in Model.Product.ProductImages)
                        {
                            <div class="img-item col-2">
                                <a href="#" data-id="@img.ImageNumber">
                                    <img src="~/@img.ImageUrl" alt="@img.ImageNumber">
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <!-- card right -->
            <div class="product-content">
                <h2 class="product-title">@Model.Product.Title</h2>
                <a class="product-link"
                   asp-controller="Products" asp-action="BrandProducts"
                   asp-route-searchString="@Model.Product.Brand">
                    @Model.Product.Brand
                </a>
                <!--Rating Start (add later)-->
                @if (userAuthintecated && !Model.ProductRatedByUser)
                {
                    <div class="product-rating">
                        <span>Rate this Product : </span>
                        <a asp-action="Rate" asp-route-rate="1" asp-route-productId="@Model.Product.Id">
                            <i class="fas fa-star"></i>
                        </a>
                        <a asp-action="Rate" asp-route-rate="2" asp-route-productId="@Model.Product.Id">
                            <i class="fas fa-star"></i>
                        </a>
                        <a asp-action="Rate" asp-route-rate="3" asp-route-productId="@Model.Product.Id">
                            <i class="fas fa-star"></i>
                        </a>
                        <a asp-action="Rate" asp-route-rate="4" asp-route-productId="@Model.Product.Id">
                            <i class="fas fa-star"></i>
                        </a>
                        <a asp-action="Rate" asp-route-rate="5" asp-route-productId="@Model.Product.Id">
                            <i class="fas fa-star"></i>
                        </a>
                        <!--Put rating summary in this span-->
                        <span>@Model.TotalRating (@Model.RatingCount)</span>
                    </div>
                }
                <!--Rating End (add later)-->
                <!--Price Start-->

                @if (Model.Product.DiscountPercentage > 0)
                {

                    <div class="product-price">
                        <p class="last-price">Old Price: <span>EGP @Model.Product.Price </span></p>
                        <p class="new-price">
                            New Price:
                            <span>
                                EGP @Model.Product.PriceAfterDiscount (@Model.Product.DiscountPercentage%)
                            </span>
                        </p>
                    </div>
                }
                else
                {
                    <div class="product-price">
                        <p class="new-price">
                            Price:
                            <span>
                                EGP @Model.Product.Price
                            </span>
                        </p>
                    </div>
                }
                <!--Price End-->
                <div class="product-detail">
                    <h2>about this item: </h2>
                    <!--Product Rating start-->
                    <div class="product-rating">
                        <span>Rate </span>
                        <a >
                            <i class="fas fa-star"></i>
                        </a>
                        <a >
                            <i class="fas fa-star"></i>
                        </a>
                        <a >
                            <i class="fas fa-star"></i>
                        </a>
                        <a >
                            <i class="fas fa-star"></i>
                        </a>
                        <a >
                            <i class="fas fa-star"></i>
                        </a>
                        <!--Put rating summary in this span-->
                        <span>@Model.TotalRating /5  (@Model.RatingCount)</span>
                    </div>
                    <!--Product Rating end-->
                    <p>@Model.Product.ShortDescription</p>
                    <h2>Details</h2>
                    <ul>
                        @foreach (var detail in Model.Product.ProductDetails)
                        {
                            <li>@detail.Title: <span>@detail.Content</span></li>
                        }
                    </ul>
                </div>

                <div class="purchase-info">

                    <a class="btn btn-primary"
                       asp-controller="ShoppingCart" asp-action="AddToCart"
                       asp-route-productId="@Model.Product.Id">
                        Add to Cart <i class="fas fa-shopping-cart"></i>
                    </a>
                    @*<button type="button" class="btn">
                            Add to Cart <i class="fas fa-shopping-cart"></i>
                        </button>*@
                    <a class="btn btn-primary"
                       asp-controller="Home" asp-action="SaveProduct" asp-route-id="@Model.Product.Id">
                        Save <i class="fas fa-heart"></i>
                    </a>
                </div>


            </div>
        </div>
    </div>
</div>
<!--Youtube videos-->
<div class="jumbotron">
    <h3>Video reviews</h3>
    <div class="row">
        @if (Model.YoutubeVideos != null && Model.YoutubeVideos.Any())
        {
            @foreach (var video in Model.YoutubeVideos)
            {
                <div class="col-md-6">
                    <iframe width="560" height="315" src="https://www.youtube.com/embed/@video.Id"
                            title="YouTube video player" frameborder="0" allow="accelerometer; autoplay;
                        clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                    <h4>@video.Title</h4>
                </div>

            }
        }
        else
        {
            <div class="col-md-6">
                <h5>No Videos to display!</h5>
            </div>
        }
    </div>
</div>




@section Scripts{
    <script src="~/js/product/ProductDetailScript.js"></script>
}